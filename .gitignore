# Generated frontend runtime catalogs and sanitized fixture projections. They
# are rebuilt from canonical source files by `npm run assets:build` before dev
# and production builds.
prototype/auris-flow-ui/src/catalogs/production/
prototype/auris-flow-ui/src/features/*/fixtures/production/

