APP_ENV=local
APP_NAME=auris-flow-bff
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
SECURITY_HEADERS_ENABLED=true
DATABASE_URL=mysql+pymysql://auris:auris@127.0.0.1:3306/auris_flow
# Optional, destructive migration verification target. It must be a separate,
# disposable test database and must never equal DATABASE_URL.
# MIGRATION_DATABASE_URL=mysql+pymysql://root:auris_root@127.0.0.1:3306/auris_flow_migration_test
REDIS_URL=redis://127.0.0.1:6379/0
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=auris-flow-local
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ADDRESSING_STYLE=path
OBJECT_STORAGE_SIGNATURE_MODE=s3v4
OBJECT_STORAGE_ALLOWED_BUCKETS=auris-flow-local
AURIS_OBJECT_STORAGE_ADAPTER=local

# 混合对象存储按登记对象的 provider 路由；未配置的 provider 会拒绝读取，
# 不会回退到其他 provider 的 endpoint 或 AK/SK。生产环境请使用密钥管理注入。
# OBJECT_STORAGE_MINIO_ENDPOINT=http://127.0.0.1:9000
# OBJECT_STORAGE_MINIO_ACCESS_KEY=
# OBJECT_STORAGE_MINIO_SECRET_KEY=
# OBJECT_STORAGE_MINIO_REGION=us-east-1
# OBJECT_STORAGE_MINIO_ADDRESSING_STYLE=path
# OBJECT_STORAGE_MINIO_SIGNATURE_MODE=s3v4
# OBJECT_STORAGE_MINIO_ALLOWED_BUCKETS=auris-flow-local
# OBJECT_STORAGE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# OBJECT_STORAGE_S3_ACCESS_KEY=
# OBJECT_STORAGE_S3_SECRET_KEY=
# OBJECT_STORAGE_S3_REGION=us-east-1
# OBJECT_STORAGE_S3_SESSION_TOKEN=
# OBJECT_STORAGE_S3_ADDRESSING_STYLE=virtual
# OBJECT_STORAGE_S3_SIGNATURE_MODE=s3v4
# OBJECT_STORAGE_S3_ALLOWED_BUCKETS=auris-flow-prod
# OBJECT_STORAGE_OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
# OBJECT_STORAGE_OBS_ACCESS_KEY=
# OBJECT_STORAGE_OBS_SECRET_KEY=
# OBJECT_STORAGE_OBS_REGION=cn-north-4
# OBJECT_STORAGE_OBS_SESSION_TOKEN=
# OBJECT_STORAGE_OBS_ADDRESSING_STYLE=virtual
# OBJECT_STORAGE_OBS_SIGNATURE_MODE=obs
# OBJECT_STORAGE_OBS_ALLOWED_BUCKETS=auris-flow-prod
# OBJECT_STORAGE_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OBJECT_STORAGE_OSS_ACCESS_KEY=
# OBJECT_STORAGE_OSS_SECRET_KEY=
# OBJECT_STORAGE_OSS_REGION=cn-hangzhou
# OBJECT_STORAGE_OSS_SESSION_TOKEN=
# OBJECT_STORAGE_OSS_ADDRESSING_STYLE=virtual
# OBJECT_STORAGE_OSS_SIGNATURE_MODE=ossv4
# OBJECT_STORAGE_OSS_ALLOWED_BUCKETS=auris-flow-prod
QDRANT_URL=http://127.0.0.1:6333
# Required when AURIS_QDRANT_ADAPTER=real in prod/release; inject from secret storage.
QDRANT_API_KEY=
AURIS_QDRANT_ADAPTER=local
DAGSTER_GRAPHQL_URL=http://127.0.0.1:3000/graphql
AURIS_DAGSTER_ADAPTER=local
DAGSTER_REPOSITORY_LOCATION_NAME=auris_flow_defs
DAGSTER_REPOSITORY_NAME=auris_flow
DAGSTER_DEFAULT_JOB_NAME=auris_flow_generic_job
AURIS_EXTERNAL_CALLBACK_ADAPTER=local
EXTERNAL_CALLBACK_URL=http://127.0.0.1:8089/callbacks/platform
EXTERNAL_CALLBACK_SECRET=auris-dev-callback-secret
DEPENDENCY_CHECK_MODE=local
REQUIRED_DEPENDENCY_CHECKS=auto

# Promptfoo is an optional CI/CD evaluation adapter, never a business truth source.
# "disabled" produces no command plan; "optional" remains non-blocking when the
# executable is absent. The internal EvalRun/LabelEvalResult gates stay mandatory.
AURIS_PROMPTFOO_ADAPTER=disabled
PROMPTFOO_EXECUTABLE=promptfoo
PROMPTFOO_TIMEOUT_SECONDS=7200

AUTH_PROVIDER=auto
AUTH_TOKEN_SECRET=
AUTH_TOKEN_ISSUER=auris-flow
AUTH_TOKEN_AUDIENCE=auris-flow-api
AUTH_TOKEN_CLOCK_SKEW_SECONDS=30
AUTH_SESSION_LAST_SEEN_INTERVAL_SECONDS=60
# Local/test/CI only. The dev-login endpoint is unavailable in prod/release even when these are set.
DEV_AUTH_PASSWORD=auris-demo
DEV_AUTH_SESSION_TTL_SECONDS=28800
AUDIO_PLAYBACK_GRANT_SECRET=replace-with-separate-32-plus-char-playback-secret
AUDIO_PLAYBACK_GRANT_TTL_SECONDS=300
DEV_AUTH_TOKEN=dev-token
ALLOW_DEV_AUTH=true
COMPLETION_RECEIPT_SECRET=replace-with-32-plus-char-hmac-secret
COMPLETION_RECEIPT_SIGNATURE_ID=auris-local-completion
# Production must use a key-id map with explicit source and tenant/project scope bindings.
# COMPLETION_RECEIPT_KEY_BINDINGS={"dagster-key":{"secret":"replace-with-32-plus-char-hmac-secret","allowed_sources":["dagster"],"allowed_scopes":[{"tenant_id":"aurora_auto","project_id":"sales_qa"}]}}
COMPLETION_RECEIPT_KEY_BINDINGS=
COMPLETION_RECEIPT_SIGNATURE_TOLERANCE_SECONDS=300
COMPLETION_RECEIPT_ALLOWED_SOURCES=dagster,object_storage,external_callback
EXPERIMENT_ASSIGNMENT_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_PER_MINUTE=240
OUTBOX_LEASE_SECONDS=60
OUTBOX_CLAIM_BATCH_SIZE=1
OUTBOX_CLAIM_RETRIES=3
OUTBOX_CLAIM_RETRY_BASE_MS=25
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_RETRY_JITTER_SECONDS=5

# 独立进程或 Dagster schedule 都调用同一个 run_once；默认关闭，启用后每分钟
# 扫描强表中的 due 配置。阈值时钟固定至少 15 分钟，claim 与业务写同事务提交。
LABEL_OPTIMIZATION_SCHEDULER_ENABLED=false
LABEL_OPTIMIZATION_SCHEDULER_POLL_SECONDS=60
LABEL_OPTIMIZATION_SCHEDULER_BATCH_SIZE=20
LABEL_OPTIMIZATION_SCHEDULER_CLAIM_LEASE_SECONDS=120
LABEL_OPTIMIZATION_SCHEDULER_WORKER_ID=label-opt-scheduler-local
