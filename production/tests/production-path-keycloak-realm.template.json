{
  "realm": "auris-flow",
  "enabled": true,
  "displayName": "Auris Flow Production Gate",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "auris-flow-web",
      "name": "Auris Flow Web Production Gate",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://__AURIS_PUBLIC_HOST__/api/v1/auth/oidc/callback"
      ],
      "postLogoutRedirectUris": [
        "https://__AURIS_PUBLIC_HOST__/*"
      ],
      "webOrigins": [
        "https://__AURIS_PUBLIC_HOST__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.url": "https://__AURIS_PUBLIC_HOST__/api/v1/auth/oidc/back-channel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "auris-flow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "auris-flow-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "id": "9d1c5cc4-e661-4af6-8a6f-7402d2555c35",
      "username": "bootstrap-operator",
      "email": "bootstrap-operator@auris.invalid",
      "emailVerified": true,
      "enabled": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__AURIS_BOOTSTRAP_OPERATOR_PASSWORD__",
          "temporary": false
        }
      ],
      "attributes": {
        "aurisBootstrapManaged": [
          "true"
        ],
        "aurisProductionGateOnly": [
          "true"
        ]
      }
    }
  ]
}
