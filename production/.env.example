# Copy to production/.env and replace every example hostname before starting.
COMPOSE_PROJECT_NAME=auris-flow
AURIS_PUBLIC_HOST=auris.example.com
AURIS_EXTERNAL_CALLBACK_URL=https://platform.example.com/callbacks/auris-flow
AURIS_EXTERNAL_CALLBACK_HOST=platform.example.com
AURIS_EMBEDDING_ENDPOINT=https://embeddings.example.com/v1/embeddings
AURIS_EMBEDDING_MODEL=multilingual-semantic-v1
AURIS_EMBEDDING_DIMENSION=1024

# Generic OIDC settings. These defaults use the bundled Keycloak reference IdP;
# replace the issuer/discovery/client/audience values for any standards-compatible IdP.
AURIS_OIDC_ISSUER=https://${AURIS_PUBLIC_HOST}/realms/auris-flow
AURIS_OIDC_DISCOVERY_URL=https://${AURIS_PUBLIC_HOST}/realms/auris-flow/.well-known/openid-configuration
AURIS_OIDC_CLIENT_ID=auris-flow-web
AURIS_OIDC_AUDIENCE=auris-flow-api
AURIS_OIDC_REDIRECT_URI=https://${AURIS_PUBLIC_HOST}/api/v1/auth/oidc/callback
AURIS_OIDC_SCOPES=openid profile email
AURIS_OIDC_JWKS_CACHE_TTL_SECONDS=300
AURIS_OIDC_CLOCK_SKEW_SECONDS=30
AURIS_OIDC_HTTP_TIMEOUT_SECONDS=5

# The reference client is public Authorization Code + PKCE and has no client secret.
# For a confidential client, set this to an absolute root-readable file and add
# `-f compose.oidc-confidential.yaml`; never put the secret value in this env file.
# AURIS_OIDC_CLIENT_SECRET_SOURCE_FILE=/absolute/path/to/oidc_client_secret

# Stable bootstrap mapping for the reference realm. Override these identifiers when
# the external IdP uses a different subject or an existing internal identity/user.
AURIS_BOOTSTRAP_OIDC_SUBJECT=9d1c5cc4-e661-4af6-8a6f-7402d2555c35
AURIS_BOOTSTRAP_IDENTITY_ID=oidc_bootstrap_operator_001
AURIS_BOOTSTRAP_USER_ID=u_bootstrap_operator_001

# Exact, immutable release tags are set by the release workflow. Never use latest.
AURIS_RELEASE_TAG=dev
AURIS_BFF_IMAGE=auris-flow-bff:dev
AURIS_EDGE_IMAGE=auris-flow-edge:dev
AURIS_DAGSTER_IMAGE=auris-flow-dagster:dev

# Version-pinned upstream images used only while rendering a source candidate.
# A signed deployment bundle ignores these mutable defaults: its generated
# production/compose.yaml already contains every exact TAG@sha256:DIGEST.
MYSQL_IMAGE=mysql:8.4.5
REDIS_IMAGE=redis:7.4.2-alpine3.21
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
QDRANT_IMAGE=qdrant/qdrant:v1.14.1
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.2.5
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.128.0
TEMPO_IMAGE=grafana/tempo:2.8.0
PROMETHEUS_IMAGE=prom/prometheus:v3.4.1
GRAFANA_IMAGE=grafana/grafana:12.0.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1

AURIS_SECRETS_DIR=./secrets
AURIS_TLS_DIR=./tls
AURIS_BFF_WORKERS=2
AURIS_OUTBOX_WORKERS=1
AURIS_COMPLETION_RECEIPT_ACTIVE_KEY_ID=dagster-v1
# Server-owned TaskRun timeout/reconciliation policy. The supported bounds are
# 60s..7d, 5s..1h, 1s..5m and 1..500 respectively.
AURIS_TASK_RUN_DEFAULT_DEADLINE_SECONDS=7200
AURIS_TASK_RUN_STATUS_SYNC_INTERVAL_SECONDS=60
AURIS_TASK_RUN_MONITOR_POLL_SECONDS=5
AURIS_TASK_RUN_MONITOR_BATCH_SIZE=50
AURIS_HTTP_PORT=80
AURIS_HTTPS_PORT=443
AURIS_KEYCLOAK_ADMIN_PORT=127.0.0.1:18080
AURIS_GRAFANA_PORT=127.0.0.1:13000
