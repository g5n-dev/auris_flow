# Install as /etc/auris-flow/backup.env with mode 0600. This file contains
# paths and policy only; keep secret values in production/secrets or an
# external secret manager.
AURIS_BACKUP_OUTPUT_ROOT=/mnt/encrypted-backups/auris-flow
AURIS_COMPOSE_ENV_FILE=/opt/auris-flow/production/.env
AURIS_RUNTIME_METRICS_DIR=/opt/auris-flow/production/runtime-metrics
AURIS_BACKUP_LOCK_FILE=/run/lock/auris-flow-backup.lock
AURIS_BACKUP_STOP_TIMEOUT_SECONDS=120
AURIS_BACKUP_RESTART_WAIT_SECONDS=240
